# =============================================================================
# Argus environment configuration
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# =============================================================================

# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO

# --- LLM providers (need at least 2 different families for cross-family verifier) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model selection — verify exact model names on docs.anthropic.com / platform.openai.com/docs
# before committing. The verifier MUST be a different family from the extractor.
DEFAULT_SYNTHESIS_MODEL=claude-sonnet-4-6
DEFAULT_EXTRACTOR_MODEL=claude-haiku-4-5
DEFAULT_VERIFIER_MODEL=gpt-5-mini
DEFAULT_RESEARCH_MODEL=claude-sonnet-4-6

# --- Postgres (running locally, no docker) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=argus
POSTGRES_USER=argus
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://argus:@localhost:5432/argus
ALEMBIC_DATABASE_URL=postgresql://argus:@localhost:5432/argus

# --- Redis (running locally) ---
REDIS_URL=redis://localhost:6379/0

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_EVIDENCE=argus_evidence

# --- Object storage (local filesystem stub for now; swap to S3/MinIO later) ---
RAW_STORE_BACKEND=local
RAW_STORE_LOCAL_PATH=./local_data/raw
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_RAW=argus-raw
S3_REGION=us-east-1

# --- Temporal (run `temporal server start-dev` locally) ---
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=argus-default

# --- Public APIs (no key required) ---
GDELT_BASE=https://api.gdeltproject.org/api/v2
WIKIDATA_SPARQL=https://query.wikidata.org/sparql
WIKIDATA_USER_AGENT=argus/0.1 (krishnadevr07@gmail.com)

# --- Optional: hosted models / rerankers ---
HUGGINGFACE_TOKEN=
COHERE_API_KEY=

# --- Embeddings / rerankers ---
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- Vertical-specific (fill once vertical is chosen) ---
ALPHA_VANTAGE_KEY=
SEC_EDGAR_USER_AGENT=
CLIMATE_TRACE_KEY=
NOAA_API_KEY=
CONGRESS_GOV_API_KEY=
PROPUBLICA_API_KEY=
NEWSAPI_KEY=
GNEWS_KEY=

# --- Observability ---
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=argus

# --- Eval / config paths ---
GOLD_SET_PATH=./eval/gold.jsonl
TRUST_TIERS_PATH=./config/trust_tiers.yaml
